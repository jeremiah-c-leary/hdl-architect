{
  "schemaVersion": "0.8",
  "package": {
    "name": "WifiPacketRouterSubsystems",
    "doc": "The Wi-Fi packet router FPGA's subsystems: the first level of its architecture (the user's split, 2026-11-22). Each device's controller (SPI, I2C) lives in the subsystem for that device. A port bound to an FPGA pin has the pin's name and port def; the other ports come from the flows between subsystems (WifiPacketRouterInterfaces).",
    "imports": [
      {
        "name": "PartKinds::*"
      },
      {
        "name": "FpgaDevices::*"
      },
      {
        "name": "PortDefs::*"
      },
      {
        "name": "WifiPacketRouterInterfaces::*"
      },
      {
        "name": "WifiPacketRouterBehavior::*"
      }
    ],
    "partDefs": [
      {
        "name": "Ethernet",
        "doc": "1G Ethernet: the MAC (RGMII to the PHY), PHY management (MDIO) and sending and receiving frames.",
        "specializes": [
          "Subsystem"
        ],
        "performs": [
          {
            "name": "receiveFrame",
            "type": "ReceiveFrame"
          },
          {
            "name": "sendFrame",
            "type": "SendFrame"
          }
        ],
        "flows": [
          {
            "from": "eth_rgmii.rxFrame",
            "to": "receiveFrame.ethFrame"
          },
          {
            "from": "receiveFrame.cmd",
            "to": "cmd.cmd"
          },
          {
            "from": "cmd.response",
            "to": "sendFrame.response"
          },
          {
            "from": "sendFrame.ethFrame",
            "to": "eth_rgmii.txFrame"
          }
        ],
        "ports": [
          {
            "name": "eth_rgmii",
            "type": "RgmiiMac",
            "doc": "FPGA pin.",
            "items": [
              {
                "name": "rxFrame",
                "direction": "in",
                "type": "EthFrame"
              },
              {
                "name": "txFrame",
                "direction": "out",
                "type": "EthFrame"
              }
            ]
          },
          {
            "name": "eth_mdio",
            "type": "MdioController",
            "doc": "FPGA pin."
          },
          {
            "name": "eth_reset_f",
            "type": "ResetOut",
            "doc": "FPGA pin.",
            "redefines": {
              "active": "low",
              "synchronous": true,
              "clock_port": "clk"
            }
          },
          {
            "name": "cmd",
            "type": "Axi4LiteSubordinate",
            "doc": "Commands to processing.",
            "items": [
              {
                "name": "cmd",
                "direction": "out",
                "type": "Command"
              },
              {
                "name": "response",
                "direction": "in",
                "type": "Response"
              }
            ]
          },
          {
            "name": "clk",
            "type": "ClockIn"
          },
          {
            "name": "rst",
            "type": "ResetIn"
          }
        ]
      },
      {
        "name": "AdcInterface",
        "doc": "The AD9208: its JESD204B link (receive) and its SPI configuration. Gives ADC samples.",
        "specializes": [
          "Subsystem"
        ],
        "ports": [
          {
            "name": "adc_jesd",
            "type": "JesdRx",
            "doc": "FPGA pin.",
            "redefines": {
              "lanes": 8
            }
          },
          {
            "name": "adc_spi",
            "type": "Spi3WireController",
            "doc": "FPGA pin."
          },
          {
            "name": "processing",
            "type": "Axi4StreamTransmitter"
          },
          {
            "name": "Control",
            "type": "Axi4LiteSubordinate"
          },
          {
            "name": "ref_clk",
            "type": "ClockIn"
          },
          {
            "name": "rst",
            "type": "ResetIn"
          },
          {
            "name": "sysref",
            "type": "SysrefIn",
            "redefines": {
              "clock_port": "ref_clk"
            }
          },
          {
            "name": "clk",
            "type": "ClockIn"
          }
        ]
      },
      {
        "name": "DacInterface",
        "doc": "The AD9172: its JESD204B link (transmit), its SPI configuration, TXEN, reset and IRQ. Takes DAC samples.",
        "specializes": [
          "Subsystem"
        ],
        "ports": [
          {
            "name": "dac_jesd",
            "type": "JesdTx",
            "doc": "FPGA pin.",
            "redefines": {
              "lanes": 8
            }
          },
          {
            "name": "dac_spi",
            "type": "Spi4WireController",
            "doc": "FPGA pin."
          },
          {
            "name": "dac_tx_en",
            "type": "BitOut",
            "doc": "FPGA pin."
          },
          {
            "name": "dac_reset",
            "type": "ResetOut",
            "doc": "FPGA pin.",
            "redefines": {
              "active": "low",
              "synchronous": true,
              "clock_port": "clk"
            }
          },
          {
            "name": "processing",
            "type": "Axi4StreamReceiver"
          },
          {
            "name": "Control",
            "type": "Axi4LiteSubordinate"
          },
          {
            "name": "ref_clk",
            "type": "ClockIn"
          },
          {
            "name": "rst",
            "type": "ResetIn"
          },
          {
            "name": "sysref",
            "type": "SysrefIn",
            "redefines": {
              "clock_port": "ref_clk"
            }
          },
          {
            "name": "clk",
            "type": "ClockIn"
          }
        ]
      },
      {
        "name": "TempSensorInterface",
        "doc": "The TMP117: reads the temperature over I2C on request, and watches ALERT.",
        "specializes": [
          "Rtl"
        ],
        "attributes": [
          {
            "name": "zynqUltraScalePlusEstimate",
            "type": "ZynqUltraScalePlusResources",
            "redefines": {
              "lut": 300,
              "ff": 250
            },
            "doc": "Estimate for Zynq UltraScale+ devices (illustrative numbers for this example)."
          }
        ],
        "performs": [
          {
            "name": "readSensor",
            "type": "ReadSensor"
          }
        ],
        "flows": [
          {
            "from": "temp_read.request",
            "to": "readSensor.request"
          },
          {
            "from": "readSensor.temperature",
            "to": "temp_read.temperature"
          }
        ],
        "ports": [
          {
            "name": "temp_i2c",
            "type": "I2cController",
            "doc": "FPGA pin."
          },
          {
            "name": "temp_alert",
            "type": "BitIn",
            "doc": "FPGA pin."
          },
          {
            "name": "temp_read",
            "type": "Axi4LiteSubordinate",
            "doc": "Requests from processing.",
            "items": [
              {
                "name": "request",
                "direction": "in",
                "type": "TemperatureRequest"
              },
              {
                "name": "temperature",
                "direction": "out",
                "type": "Temperature"
              }
            ]
          },
          {
            "name": "clk",
            "type": "ClockIn"
          },
          {
            "name": "rst",
            "type": "ResetIn"
          }
        ]
      },
      {
        "name": "Uart",
        "doc": "Status out over the UART to the USB-UART bridge.",
        "specializes": [
          "Rtl"
        ],
        "attributes": [
          {
            "name": "zynqUltraScalePlusEstimate",
            "type": "ZynqUltraScalePlusResources",
            "redefines": {
              "lut": 250,
              "ff": 200
            },
            "doc": "Estimate for Zynq UltraScale+ devices (illustrative numbers for this example)."
          }
        ],
        "ports": [
          {
            "name": "status_uart",
            "type": "UartDte",
            "doc": "FPGA pin."
          },
          {
            "name": "processing",
            "type": "Axi4LiteSubordinate"
          },
          {
            "name": "clk",
            "type": "ClockIn"
          },
          {
            "name": "rst",
            "type": "ResetIn"
          }
        ]
      },
      {
        "name": "Processing",
        "doc": "Takes commands from Ethernet and answers them; turns ADC samples into Ethernet packets. May hold subsystems of its own.",
        "specializes": [
          "Subsystem"
        ],
        "performs": [
          {
            "name": "decodeCommand",
            "type": "DecodeCommand"
          },
          {
            "name": "buildResponse",
            "type": "BuildResponse"
          }
        ],
        "flows": [
          {
            "from": "Control.cmd",
            "to": "decodeCommand.cmd"
          },
          {
            "from": "decodeCommand.request",
            "to": "Control.request"
          },
          {
            "from": "Control.temperature",
            "to": "buildResponse.temperature"
          },
          {
            "from": "buildResponse.response",
            "to": "Control.response"
          }
        ],
        "ports": [
          {
            "name": "dac_if",
            "type": "Axi4StreamTransmitter"
          },
          {
            "name": "adc_if",
            "type": "Axi4StreamReceiver"
          },
          {
            "name": "Control",
            "type": "Axi4LiteSubordinate",
            "items": [
              {
                "name": "cmd",
                "direction": "in",
                "type": "Command"
              },
              {
                "name": "request",
                "direction": "out",
                "type": "TemperatureRequest"
              },
              {
                "name": "temperature",
                "direction": "in",
                "type": "Temperature"
              },
              {
                "name": "response",
                "direction": "out",
                "type": "Response"
              }
            ]
          },
          {
            "name": "clk",
            "type": "ClockIn"
          },
          {
            "name": "rst",
            "type": "ResetIn"
          }
        ]
      }
    ]
  }
}
