  "package": {
    "name": "WifiPacketRouterSubsystems",
    "doc": "The Wi-Fi packet router FPGA's subsystems: the first level of its architecture (the user's split, 2026-11-22). Each device's controller (SPI, I2C) lives in the subsystem for that device. A port bound to an FPGA pin has the pin's name and port def; the other ports come from the flows between subsystems (WifiPacketRouterInterfaces).",
    "imports": [
      {
        "name": "PartKinds::*"
      },
      {
        "name": "FpgaDevices::*"
      },
      {
        "name": "PortDefs::*"
      },
      {
        "name": "WifiPacketRouterInterfaces::*"
      }
    ],
    "partDefs": [
      {
        "name": "Ethernet",
        "doc": "1G Ethernet: the MAC (RGMII to the PHY), PHY management (MDIO) and sending and receiving frames.",
        "specializes": [
          "Subsystem"
        ],
        "attributes": [
          {
            "name": "zynqUltraScalePlusEstimate",
            "type": "ZynqUltraScalePlusResources",
            "redefines": {
              "lut": 9000,
              "ff": 12000,
              "bram36": 24
            },
            "doc": "Estimate for Zynq UltraScale+ devices (illustrative numbers for this example)."
          }
        ],
        "ports": [
