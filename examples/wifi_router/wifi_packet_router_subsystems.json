              "active": "low",
              "synchronous": true,
              "clock_port": "clk"
            }
          },
          {
            "name": "cmd",
            "type": "Axi4LiteSubordinate",
            "doc": "Commands to processing."
          },
          {
            "name": "clk",
            "type": "ClockIn"
          },
          {
            "name": "rst",
            "type": "ResetIn"
          }
        ]
      },
