          },
          {
            "from": "readTemperature.rspFrame",
            "to": "eth_rgmii.rspFrame"
          }
        ],
        "ports": [
          {
            "name": "sys_reset_f",
            "type": "ResetIn",
            "doc": "The FPGA's reset, from off the card (through the card's connector).",
            "redefines": {
              "active": "low",
              "synchronous": false
            }
          },
          {
            "name": "sys_clock",
            "type": "ClockIn",
            "doc": "From HMC7044 ch0 (Sys clk).",
            "redefines": {
              "frequency_hz": 100000000.0,
              "duty_cycle": 0.5
            }
          },
          {
            "name": "jesd_refclk",
            "type": "ClockIn",
            "doc": "From HMC7044 ch2 (Jesd refclk): transceiver reference clock.",
            "redefines": {
              "frequency_hz": 150000000.0,
              "duty_cycle": 0.5
            }
          },
          {
            "name": "jesd_sysref",
            "type": "SysrefIn",
            "doc": "From HMC7044 ch1 (Jesd sysref).",
            "redefines": {
              "frequency_hz": 10000000.0,
              "duty_cycle": 0.5,
              "clock_port": "jesd_refclk"
            }
          },
          {
            "name": "clock_gen_spi",
            "type": "Spi3WireController",
            "doc": "To HMC7044 SPI (SCLK, SDATA, SLEN)."
          },
          {
            "name": "adc_jesd",
            "type": "JesdRx",
            "doc": "From AD9208 JESD204B (SERDOUT0..7, SYNCINB).",
            "redefines": {
              "lanes": 8
            }
          },
          {
            "name": "adc_spi",
            "type": "Spi3WireController",
            "doc": "To AD9208 SPI (SCLK, SDIO, CSB)."
          },
          {
            "name": "dac_jesd",
            "type": "JesdTx",
            "doc": "To AD9172 JESD204B (SERDIN0..7, SYNCOUT0).",
            "redefines": {
              "lanes": 8
            }
          },
          {
            "name": "dac_spi",
            "type": "Spi4WireController",
            "doc": "To AD9172 SPI, 4-wire (SCLK, CS, SDIO as data in, SDO)."
          },
          {
            "name": "dac_tx_en",
            "type": "BitOut",
            "doc": "To AD9172 TXEN0."
          },
          {
            "name": "dac_reset",
            "type": "ResetOut",
            "doc": "To AD9172 RESET.",
            "redefines": {
              "active": "low",
              "synchronous": false
            }
          },
          {
            "name": "dac_irq",
            "type": "BitIn",
            "doc": "From AD9172 IRQ0 (open drain, active low)."
          },
          {
            "name": "eth_rgmii",
            "type": "RgmiiMac",
            "doc": "To the Ethernet PHY: RGMII, 1G. Snapshots and commands.",
            "items": [
              {
                "name": "cmdFrame",
                "direction": "in",
                "type": "EthFrame"
              },
              {
                "name": "rspFrame",
                "direction": "out",
                "type": "EthFrame"
              }
            ]
          },
          {
            "name": "eth_mdio",
            "type": "MdioController",
            "doc": "To the Ethernet PHY: MDIO management."
          },
          {
            "name": "eth_reset_f",
            "type": "ResetOut",
            "doc": "To the Ethernet PHY's reset.",
            "redefines": {
              "active": "low",
              "synchronous": false
            }
          },
          {
            "name": "status_uart",
            "type": "UartDte",
            "doc": "To the USB-UART bridge on the card: status."
          },
          {
            "name": "temp_i2c",
            "type": "I2cController",
            "doc": "To TMP117 I2C (SCL, SDA)."
          },
          {
            "name": "temp_alert",
            "type": "BitIn",
            "doc": "From TMP117 ALERT (open drain)."
          }
