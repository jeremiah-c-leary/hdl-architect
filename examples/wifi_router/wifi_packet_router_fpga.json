    "partDefs": [
      {
        "name": "WifiPacketRouterFpga",
        "doc": "The FPGA between the AD9208 ADC, the AD9172 DAC, the HMC7044 clock generator and the TMP117 temperature sensor.",
        "specializes": [
          "FpgaPart"
        ],
        "comments": [
          "OPEN: where the clocks and resets, the HMC7044's SPI, and the JESD transceivers (shared by the ADC and DAC links) go.",
          "OPEN: FPGA pins with no subsystem yet: sys_reset_f, sys_clock, jesd_refclk, jesd_sysref, clock_gen_spi."
        ],
        "attributes": [
          {
            "name": "device",
            "type": "XCZU9EG",
            "doc": "The target device."
          },
          {
            "name": "resourceMargins",
            "type": "ZynqUltraScalePlusMargins",
            "redefines": {
              "bram36": 20
            },
            "doc": "Resources to keep free; block RAM tighter than the family's 30%."
          }
        ],
