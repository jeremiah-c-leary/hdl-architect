{
  "schemaVersion": "0.4",
  "package": {
    "name": "WifiPacketRouterBehavior",
    "doc": "The Wi-Fi packet router FPGA's behaviour: what it does, as actions and the items that flow between them. The FPGA part def performs these and allocates each step to a subsystem; a flow between steps in different subsystems is an interface.",
    "itemDefs": [
      {
        "name": "EthFrame",
        "doc": "An Ethernet frame, on the wire."
      },
      {
        "name": "Command",
        "doc": "A decoded command from a frame."
      },
      {
        "name": "TemperatureRequest",
        "doc": "A request for one temperature reading."
      },
      {
        "name": "Temperature",
        "doc": "One temperature reading from the TMP117."
      },
      {
        "name": "Response",
        "doc": "The answer to a command, before it is put in a frame."
      }
    ],
    "actionDefs": [
      {
        "name": "ReadTemperature",
        "doc": "A host asks for the temperature over Ethernet; the FPGA reads the TMP117 and answers with one frame.",
        "parameters": [
          {
            "name": "cmdFrame",
            "direction": "in",
            "type": "EthFrame"
          },
          {
            "name": "rspFrame",
            "direction": "out",
            "type": "EthFrame"
          }
        ],
        "actions": [
          {
            "name": "receiveFrame",
            "doc": "Receive the command frame.",
            "parameters": [
              {
                "name": "ethFrame",
                "direction": "in",
                "type": "EthFrame"
              },
              {
                "name": "cmd",
                "direction": "out",
                "type": "Command"
              }
            ]
          },
          {
            "name": "decodeCommand",
            "doc": "Decode the command: it asks for the temperature.",
            "parameters": [
              {
                "name": "cmd",
                "direction": "in",
                "type": "Command"
              },
              {
                "name": "request",
                "direction": "out",
                "type": "TemperatureRequest"
              }
            ]
          },
          {
            "name": "readSensor",
            "doc": "Read the TMP117's temperature register over I2C.",
            "parameters": [
              {
                "name": "request",
                "direction": "in",
                "type": "TemperatureRequest"
              },
              {
                "name": "temperature",
                "direction": "out",
                "type": "Temperature"
              }
            ]
          },
          {
            "name": "buildResponse",
            "doc": "Build the response from the reading.",
            "parameters": [
              {
                "name": "temperature",
                "direction": "in",
                "type": "Temperature"
              },
              {
                "name": "response",
                "direction": "out",
                "type": "Response"
              }
            ]
          },
          {
            "name": "sendFrame",
            "doc": "Put the response in a frame and send it.",
            "parameters": [
              {
                "name": "response",
                "direction": "in",
                "type": "Response"
              },
              {
                "name": "ethFrame",
                "direction": "out",
                "type": "EthFrame"
              }
            ]
          }
        ],
        "bindings": [
          {
            "ends": [
              "receiveFrame.ethFrame",
              "cmdFrame"
            ]
          },
          {
            "ends": [
              "sendFrame.ethFrame",
              "rspFrame"
            ]
          }
        ],
        "flows": [
          {
            "from": "receiveFrame.cmd",
            "to": "decodeCommand.cmd",
            "succession": true
          },
          {
            "from": "decodeCommand.request",
            "to": "readSensor.request",
            "succession": true
          },
          {
            "from": "readSensor.temperature",
            "to": "buildResponse.temperature",
            "succession": true
          },
          {
            "from": "buildResponse.response",
            "to": "sendFrame.response",
            "succession": true
          }
        ]
      }
    ]
  }
}
